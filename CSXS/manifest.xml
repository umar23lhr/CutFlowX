<?xml version="1.0" encoding="UTF-8"?>
<!-- CutFlowX — Smart Silence Cutter for Premiere Pro. Developer: M Umar Saeed -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.umarsaeed.cutflowx" ExtensionBundleVersion="0.6.1" ExtensionBundleName="CutFlowX"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.umarsaeed.cutflowx.panel" Version="0.6.1" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- Premiere Pro 2023 (23.x) and later releases that still load CEP panels -->
      <Host Name="PPRO" Version="[23.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.umarsaeed.cutflowx.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>CutFlowX</Menu>
          <Geometry>
            <Size><Height>640</Height><Width>340</Width></Size>
            <MinSize><Height>360</Height><Width>260</Width></MinSize>
            <MaxSize><Height>2000</Height><Width>900</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
